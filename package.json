{
  "name": "zero-the-hero",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:itch": "tsc --noEmit && vite build --base=./",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "generate:world": "tsx scripts/generateWorld.ts",
    "generate:chunks": "node scripts/gen-chunk-library.mjs",
    "audit:world": "node scripts/cozy-world.mjs --check",
    "audit:stacks": "node scripts/fix-tile-stacks.mjs --check",
    "lint": "eslint . --ext .ts",
    "playtest": "node playtest/run.mjs",
    "playtest:text": "node playtest/run.mjs text-legibility",
    "playtest:all": "node playtest/run.mjs all",
    "playtest:clean": "node playtest/clean.mjs"
  },
  "dependencies": {
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@types/node": "^24.6.0",
    "@types/three": "^0.185.1",
    "@typescript-eslint/eslint-plugin": "^8.44.0",
    "@typescript-eslint/parser": "^8.44.0",
    "@vitest/coverage-v8": "^5.1.0",
    "canvas": "^3.2.3",
    "eslint": "^9.36.0",
    "jsdom": "^29.1.1",
    "playwright": "^1.60.0",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3",
    "vite": "^7.1.7",
    "vitest": "^5.1.0"
  }
}

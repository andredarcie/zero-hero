  "dialogs": {
    "catForge": {
      "npcName": "CAT",
      "npcColorHex": "#cc99ff",
      "npcAssetKey": "npcs",
      "npcFrame": 0,
      "voice": {
        "freq": 540,
        "wave": "triangle"
      },
      "lines": [
        {
          "speaker": "npc",
          "text": "Mrrow. That door wants ONE BAR OF IRON. You have no iron. You have rust-stained rock."
        },
        {
          "speaker": "npc",
          "text": "Face the FURNACE and press Z: it knows two recipes, and one of them turns ore and charcoal into a bloom. Confirming does not hand it to you — it LIGHTS the furnace. Wait for it."
        },
        {
          "speaker": "npc",
          "text": "What jumps out is a sponge, not a bar. Carry it to the stone ALTAR, press Z to lay it down, then beat it. Three blows and the slag is gone."
        },
        {
          "speaker": "npc",
          "text": "Then take the bar with B. Ore, fire, hammer, bar — there is no shortcut, and every forge in this world runs that order. Mrrow."
        },
        {
          "speaker": "npc",
          "text": "The marked box takes the IRON you earned here. Load it, and the plane drops your coins."
        }
      ]
    }
  }

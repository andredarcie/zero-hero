      "lines": [
        {
          "speaker": "npc",
          "text": "Mrrow. Dead wood. Your sword will not move it — a blade cuts what bleeds."
        },
        {
          "speaker": "npc",
          "text": "The AXE is at my feet. Take it, face a dead tree, and press X. Four swings and it comes down."
        },
        {
          "speaker": "npc",
          "text": "A felled tree leaves a STICK behind. Keep every one of them: a stick is a torch that has not met fire yet."
        },
        {
          "speaker": "npc",
          "text": "Behind that wall there is iron, and nothing guarding it. Nothing walks in here. Take your time. Mrrow."
        }
      ]
    }

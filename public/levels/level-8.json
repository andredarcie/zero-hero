  "dialogs": {
    "catSword": {
      "npcName": "CAT",
      "npcColorHex": "#cc99ff",
      "npcAssetKey": "npcs",
      "npcFrame": 0,
      "voice": {
        "freq": 540,
        "wave": "triangle"
      },
      "lines": [
        {
          "speaker": "npc",
          "text": "Mrrow. Take the SWORD. Press Z — and press it again, and again."
        },
        {
          "speaker": "npc",
          "text": "Nothing here falls to one blow. Strike a body that is still flashing and your blade slides off it: that flash is a body that cannot be hurt yet. Wait a beat."
        },
        {
          "speaker": "npc",
          "text": "And watch their feet. When one plants itself and winds up, it is GUARDING the side it faces. Hitting that side gives you sparks and nothing else — walk around it."
        },
        {
          "speaker": "npc",
          "text": "Hold Z instead of tapping it and the blade spins: it cuts all eight neighbours at once. Mrrow. Go on."
        },
        {
          "speaker": "npc",
          "text": "The marked box takes the IRON you earned here. Load it, and the plane drops your coins."
        }
      ]
    }

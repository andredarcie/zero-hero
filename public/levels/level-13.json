  "dialogs": {
    "catFlower": {
      "npcName": "CAT",
      "npcColorHex": "#cc99ff",
      "npcAssetKey": "npcs",
      "npcFrame": 0,
      "voice": {
        "freq": 540,
        "wave": "triangle"
      },
      "lines": [
        {
          "speaker": "npc",
          "text": "Mrrow. The way through is a FLOWER, and it is shut."
        },
        {
          "speaker": "npc",
          "text": "It is shut because of my fire. That bud opens in the dark and closes in the light — it has no opinion about you at all."
        },
        {
          "speaker": "npc",
          "text": "Take the BUCKET. Face the puddle and press X to fill it; face the fire and press X to throw it."
        },
        {
          "speaker": "npc",
          "text": "Water is the only thing in this world that puts fire OUT. Everything else you own only starts them. Mrrow."
        },
        {
          "speaker": "npc",
          "text": "The marked box takes the IRON you earned here. Load it, and the plane drops your coins."
        }
      ]
    }

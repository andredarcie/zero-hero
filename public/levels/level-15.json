  "dialogs": {
    "catBattery": {
      "npcName": "CAT",
      "npcColorHex": "#cc99ff",
      "npcAssetKey": "npcs",
      "npcFrame": 0,
      "voice": {
        "freq": 540,
        "wave": "triangle"
      },
      "lines": [
        {
          "speaker": "npc",
          "text": "Mrrow. The gate needs current and the cable at its side is DEAD. Look at it: no glow."
        },
        {
          "speaker": "npc",
          "text": "The wheel on the river makes plenty — the belt over there runs on it. But that cable stops three tiles short, and I am a cat, not an electrician."
        },
        {
          "speaker": "npc",
          "text": "Take the BATTERY. Stand on the live cable and it drinks; you will see it fill."
        },
        {
          "speaker": "npc",
          "text": "Then face the dead cable and press X to seat it there. A battery is a piece of wire you can carry. Mrrow."
        }
      ]
    }

      "npcFrame": 0,
      "voice": {
        "freq": 540,
        "wave": "triangle"
      },
      "lines": [
        {
          "speaker": "npc",
          "text": "Mrrow. The plate over there opens the door. Stand on it and see."
        },
        {
          "speaker": "npc",
          "text": "You saw. The door is open and you are on the plate, which is the whole joke: your weight cannot be in two places."
        },
        {
          "speaker": "npc",
          "text": "So send something else. Walk INTO the crate to push it — no button, just your body — and park it on the plate."
        },
        {
          "speaker": "npc",
          "text": "The plate never asked for you. It asks for weight. A crate does; so does a skull, if one ever wanders onto it. Mrrow."
        }
      ]
    }

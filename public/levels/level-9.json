  "dialogs": {
    "catCrossing": {
      "npcName": "CAT",
      "npcColorHex": "#cc99ff",
      "npcAssetKey": "npcs",
      "npcFrame": 0,
      "voice": {
        "freq": 540,
        "wave": "triangle"
      },
      "lines": [
        {
          "speaker": "npc",
          "text": "Mrrow. Water. You cannot swim and you cannot chop it."
        },
        {
          "speaker": "npc",
          "text": "One tile of that bank will take a crossing. Face it and press X holding TWO STICKS and you nail a plank deck. Or hold ONE STONE and you drop a ford."
        },
        {
          "speaker": "npc",
          "text": "They carry you the same. They do not carry FIRE the same: flame runs across planks and eats them. It stops dead at stone, every time."
        },
        {
          "speaker": "npc",
          "text": "So the question is never \"how do I cross\". It is: do I want a floor here, or a fuse? Mrrow."
        },
        {
          "speaker": "npc",
          "text": "The marked box takes the IRON you earned here. Load it, and the plane drops your coins."
        }
      ]
    }
  }

  "dialogs": {
    "catGate": {
      "npcName": "CAT",
      "npcColorHex": "#cc99ff",
      "npcAssetKey": "npcs",
      "npcFrame": 0,
      "voice": {
        "freq": 540,
        "wave": "triangle"
      },
      "lines": [
        {
          "speaker": "npc",
          "text": "Mrrow. Two gates, same wood, same hinge. Walk into the top one."
        },
        {
          "speaker": "npc",
          "text": "It shudders and stays shut. Nothing is locked — there is a BOULDER sitting against its back, and a gate that swings inward cannot swing through stone."
        },
        {
          "speaker": "npc",
          "text": "The lower one has nothing behind it. Walk into that one and it gives."
        },
        {
          "speaker": "npc",
          "text": "No key exists for either. A swing gate only ever asks one thing: is the tile behind me empty? Mrrow."
        }
      ]
    }

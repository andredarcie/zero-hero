      "lines": [
        {
          "speaker": "npc",
          "text": "Mrrow. That rock is not going anywhere. No pick in the world opens it."
        },
        {
          "speaker": "npc",
          "text": "But look at the ground — one tile is MARKED. That is where the stone is thin."
        },
        {
          "speaker": "npc",
          "text": "Take a BOMB and stand on the mark: it arms itself the moment you get there, and it counts. Then leave. Three of them on the floor, so you may waste two learning."
        },
        {
          "speaker": "npc",
          "text": "Everything you carry that burns, burns on its own clock. Mrrow."
        }
      ]
    }

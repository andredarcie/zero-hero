  "dialogs": {
    "catFarm": {
      "npcName": "CAT",
      "npcColorHex": "#cc99ff",
      "npcAssetKey": "npcs",
      "npcFrame": 0,
      "voice": {
        "freq": 540,
        "wave": "triangle"
      },
      "lines": [
        {
          "speaker": "npc",
          "text": "Mrrow. Take the SCYTHE and cut that tall grass. What it leaves behind is SEEDS."
        },
        {
          "speaker": "npc",
          "text": "Now the SHOVEL. Face bare earth — plain dirt, not stone — and press X. It opens a hole."
        },
        {
          "speaker": "npc",
          "text": "Walk over the hole while you carry seeds and they sow themselves. Then fill the BUCKET at the puddle with X, face the mound, and throw it."
        },
        {
          "speaker": "npc",
          "text": "Wait a moment and it comes up as real grass: it blocks, it burns, and the scythe takes it again. The hole reopens under it."
        },
        {
          "speaker": "npc",
          "text": "It never MULTIPLIES — one seed, one clump, forever. What a farm gives you is grass WHERE YOU WANT IT: a fuse you can lay by hand."
        },
        {
          "speaker": "npc",
          "text": "And the box beside me buys the spare. The sign on it shows what it takes; face it with X and it pays, coins on the ground. Mrrow."
        },
        {
          "speaker": "npc",
          "text": "The marked box takes the SEEDS you earned here. Load it, and the plane drops your coins."
        }
      ]
    }
  }
